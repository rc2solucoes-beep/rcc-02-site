# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
SUPABASE_SERVICE_ROLE_KEY=xxxx

# ─────────────────────────────────────────────
# Cloudflare Turnstile (anti-spam formulário)
# Regra:
# - Em produção com secret real: token obrigatório e válido.
# - Em desenvolvimento/teste: bypass apenas com secret ausente ou placeholder.
# ─────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=xxxx
TURNSTILE_SECRET_KEY=xxxx

# ─────────────────────────────────────────────
# Resend (e-mail de notificação de leads)
# ─────────────────────────────────────────────
RESEND_API_KEY=xxxx
LEAD_NOTIFICATION_EMAIL=contato@rc2solucoes.com.br

# Exclusão definitiva de leads (E2): SUSPENSA por padrão. Só o texto exato "true" libera na aplicação, e a
# migration 016 já retira o DELETE no banco: reabilitar exige uma migration nova (ver runbook da 016).
# LEADS_DELETE_ENABLED=true

# ─────────────────────────────────────────────
# Segurança
# ─────────────────────────────────────────────
# Salt primário para hashing dos audit logs administrativos (obrigatório em produção)
AUDIT_LOG_SALT=gere-uma-string-aleatoria-forte-aqui
# Salt para anonimização de IPs no banco (qualquer string aleatória, mín. 16 chars)
# Fallback legado se AUDIT_LOG_SALT não estiver definido
IP_SALT=gere-uma-string-aleatoria-aqui

# ─────────────────────────────────────────────
# Google Places API (avaliações do Google Business)
# ─────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=AIza...
GOOGLE_PLACE_ID=0x94cef52583ad1a8d:0xf9d6abeb964d95b2

# ─────────────────────────────────────────────
# Sentry (monitoramento de erros)
# ─────────────────────────────────────────────
SENTRY_DSN=xxxx
NEXT_PUBLIC_SENTRY_DSN=xxxx

# ─────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://rc2solucoes.com.br
NEXT_PUBLIC_WHATSAPP_NUMBER=5511988028550

# ─────────────────────────────────────────────
# Testes E2E (Playwright) — não vai para produção
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@rc2solucoes.com.br
ADMIN_PASSWORD=xxxx

# ─────────────────────────────────────────────
# Testes de integração de RLS (ambiente Supabase ISOLADO)
# NUNCA aponte para produção. Os valores reais ficam em .env.test.local
# (ignorado pelo git). A guarda recusa a execução se o alvo não for um
# projeto de teste da allowlist ou se for o de produção.
# ─────────────────────────────────────────────
RC2_TEST_SUPABASE_URL=
RC2_TEST_PROJECT_REF=
RC2_TEST_PROJECT_REF_ALLOWLIST=
RC2_PRODUCTION_PROJECT_REF=
RC2_TEST_SUPABASE_ANON_KEY=
RC2_TEST_SUPABASE_SERVICE_ROLE_KEY=

# Defina "true" somente depois de confirmar que o dominio passa pelo proxy do Cloudflare (PV-07).
# Habilita a leitura de cf-connecting-ip no helper de IP. Padrao: desligado.
TRUST_CLOUDFLARE_PROXY=false

# Pepper do HMAC das chaves de rate limit do contato (E0c, RF-SEG-05, DEP-05). OBRIGATORIO em
# Preview e Production antes do deploy da E0c: sem ele (ou com menos de 32 caracteres) a rota
# de contato FECHA (HTTP 429). Gere um valor aleatorio por ambiente (ex.: 32 bytes em hex) e NUNCA
# o reutilize entre ambientes; trocar o valor reinicia os contadores. Nao entra no repositorio.
RATE_LIMIT_PEPPER=

# Newsletter (E3, SDD Newsletter §18.5). DESLIGADAS por padrao. Nenhuma ativacao publica antes
# da E4-essencial (BL-11), do isolamento de rastreadores (BL-05), do mecanismo de dispatch (BL-03)
# e da validacao juridica (BL-01). Estas variaveis nao configuram Resend, DNS nem jobs de envio.
NEWSLETTER_SIGNUP_ENABLED=false
NEWSLETTER_CONFIRMATION_DISPATCH_ENABLED=false
