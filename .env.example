# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
SUPABASE_SERVICE_ROLE_KEY=xxxx

# ─────────────────────────────────────────────
# Cloudflare Turnstile (anti-spam formulário)
# ─────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=xxxx
TURNSTILE_SECRET_KEY=xxxx

# ─────────────────────────────────────────────
# Resend (e-mail de notificação de leads)
# ─────────────────────────────────────────────
RESEND_API_KEY=xxxx
LEAD_NOTIFICATION_EMAIL=contato@rc2solucoes.com.br

# ─────────────────────────────────────────────
# Segurança
# ─────────────────────────────────────────────
# Salt primário para hashing dos audit logs administrativos (obrigatório em produção)
AUDIT_LOG_SALT=gere-uma-string-aleatoria-forte-aqui
# Salt para anonimização de IPs no banco (qualquer string aleatória, mín. 16 chars)
# Fallback legado se AUDIT_LOG_SALT não estiver definido
IP_SALT=gere-uma-string-aleatoria-aqui

# ─────────────────────────────────────────────
# Google Places API (avaliações do Google Business)
# ─────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=AIza...
GOOGLE_PLACE_ID=0x94cef52583ad1a8d:0xf9d6abeb964d95b2

# ─────────────────────────────────────────────
# Sentry (monitoramento de erros)
# ─────────────────────────────────────────────
SENTRY_DSN=xxxx
NEXT_PUBLIC_SENTRY_DSN=xxxx

# ─────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://rc2solucoes.com.br
NEXT_PUBLIC_WHATSAPP_NUMBER=5511988028550

# ─────────────────────────────────────────────
# Testes E2E (Playwright) — não vai para produção
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@rc2solucoes.com.br
ADMIN_PASSWORD=xxxx
