# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.example é rastreado intencionalmente

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db

# MCP and secrets
# .mcp.json é a configuração MCP compartilhada do projeto e pode ser versionada.
# Credenciais nunca devem ser armazenadas nela — use variáveis de ambiente.
.env*.local

# Claude Code — só a governança compartilhada do projeto é versionada, por
# allowlist explícita. Continua ignorado: settings.local.json (preferências
# pessoais), junctions de .claude/skills/ (apontam para caminhos absolutos da
# máquina; o conteúdo real é versionado em .agents/skills/), locks e o resto.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/post-edit-validate.mjs
!.claude/agents/
.claude/agents/*
!.claude/agents/governance-reviewer.md
!.claude/agents/seo-migration-checker.md
!.claude/skills/
.claude/skills/*
!.claude/skills/pre-pr/
.claude/skills/pre-pr/*
!.claude/skills/pre-pr/SKILL.md

# Playwright MCP artefacts
.playwright-mcp/
playwright-report/
test-results/

# Superpowers local planning notes (never commit)
docs/superpowers/plans/2026-05-17-html-mode-post-editor.md
docs/superpowers/plans/2026-05-17-post-author-reuse.md

# Contrast audit HTML (brainstorming artefact)
contrast-audit.html

# Codex CLI
.codex/

# Isolated feature worktrees
.worktrees/
